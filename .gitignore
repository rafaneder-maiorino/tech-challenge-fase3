# Ambientes virtuais
.venv/
.venv-extract/

# Dados brutos (baixados do Hugging Face) e derivados (regeneráveis)
data/raw*/
data/processed/

# Artefatos de modelo (regeneráveis via src/models/baseline.py)
models/*.joblib
models/*.onnx

# Métricas versionadas geradas a cada execução da DAG train_pipeline.
# reports/baseline_metrics.json (da CLI) continua versionado.
reports/metrics_*.json

# Airflow (gerado em runtime pelos containers)
airflow/logs/
airflow/.env
airflow/plugins/__pycache__/
airflow/dags/__pycache__/
airflow/config/airflow.cfg
airflow/airflow-webserver.pid
airflow/standalone_admin_password.txt

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
