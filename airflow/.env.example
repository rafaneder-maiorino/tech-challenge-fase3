# Copie para `.env` neste mesmo diretório e ajuste se precisar:
#   cp .env.example .env
# O docker compose lê `.env` automaticamente. Todos os valores têm default
# no docker-compose.airflow.yml, então o `.env` é opcional.

# UID com que os processos do Airflow rodam dentro do container.
#
# macOS (Docker Desktop): MANTENHA 50000. O VirtioFS/gRPC-FUSE já traduz o
#   dono dos bind mounts para o usuário do host, então o uid do host (501)
#   NÃO deve ser usado aqui — 50000 é o uid do usuário `airflow` na imagem.
# Linux: use o seu uid real, senão `logs/` fica com arquivos de root no host:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Porta do host para a UI. 8080 é o default do Airflow e está livre aqui
# (a API do projeto roda na 8000). Troque se der conflito na sua máquina.
AIRFLOW_WEB_PORT=8080

# Credenciais do admin da UI (ambiente local apenas).
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Chaves de desenvolvimento. Em produção seriam secrets de verdade.
# Gerar novas:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   python3 -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_FERNET_KEY=x-nBzJo2vtDUDCV_iu5FFenIobfbUgDLUqkxoGEplCE=
AIRFLOW_SECRET_KEY=4fa8498ca135f72f6a416bbe40cad4eb
